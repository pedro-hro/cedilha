{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "cedilha",
  "version": "0.1.0",
  "identifier": "com.omarchy.cedilha",
  "build": {
    "frontendDist": "../build",
    "beforeBuildCommand": "bun run build",
    "beforeDevCommand": "bun run dev"
  },
  "app": {
    "windows": [
      {
        "title": "Cedilha",
        "width": 1000,
        "height": 750,
        "minWidth": 640,
        "minHeight": 480,
        "transparent": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}

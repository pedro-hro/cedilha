{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Window state, dragging and events; everything else goes through app commands",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-start-dragging"
  ]
}
